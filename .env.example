# ------------------------------------------------------------------
# DevForge API environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env - it is ignored by git.
# ------------------------------------------------------------------

# --- Server ---
# Port the DevForge API listens on.
PORT=4000
# Public origin of the API. Used for CORS and cookie configuration in production.
API_URL=http://localhost:4000
# Allowed client origin(s). Comma-separated. Leave as the Vite dev origin locally.
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# The committed schema (prisma/schema.prisma) uses PostgreSQL, which is
# required on serverless hosts like Vercel (their filesystem is read-only and
# ephemeral, so SQLite cannot persist). Point DATABASE_URL at any Postgres:
#   • Neon free tier:      postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/devforge?sslmode=require
#   • Supabase:            postgresql://postgres.PROJECT:POSTGRES_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   • Vercel Postgres:     postgresql://USER:PASSWORD@ep-xxx-pooler.aws.neon.tech/devforge?sslmode=require
#   • Local Postgres:      postgresql://USER:PASSWORD@localhost:5432/devforge?schema=public
# After setting DATABASE_URL run: npm run db:push   (then: npm run db:seed)
#
# For fully-local zero-setup development WITHOUT a database server, use the
# SQLite variant instead (a local prisma/devforge.db file). The SQLite schema
# cannot be deployed to Vercel:
#   npm run db:generate:sqlite && npm run db:push:sqlite && npm run db:seed:sqlite
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/devforge?schema=public

# --- Authentication / sessions ---
# Long random string used to sign session values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# How long a login session lasts before it must be renewed (in days).
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Cookie SameSite policy. Use "none" when the client and API live on different
# origins in production (requires COOKIE_SECURE=true). Local dev keeps "lax".
COOKIE_SAME_SITE=lax

# --- Demo mode flags ---
# When true the app clearly labels demo/estimated repo + deployment data.
# Set to false once real integrations are configured.
DEMO_MODE=true

# --- Google sign-up / sign-in (optional) ---
# Enables "Continue with Google" on the login and register screens. Create a
# Google OAuth client at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs). The redirect URI below must match exactly the
# "Authorized redirect URIs" of the client, and the Google OAuth consent must
# include the userinfo.email scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Where the browser is sent after a Google OAuth redirect (your app origin).
GOOGLE_APP_ORIGIN=http://localhost:5173

# --- GitHub integration (optional) ---
# Repository sync has two modes:
#   • OAuth (recommended): each user signs in with their own GitHub account. The
#     token is read-only (scope `public_repo`) and stored encrypted at rest. To
#     enable it, create a GitHub OAuth app at
#     https://github.com/settings/developers and set:
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The OAuth callback must match exactly the "Authorization callback URL" of the
# GitHub OAuth app (e.g. https://api.example.com/api/github/callback on prod).
GITHUB_REDIRECT_URI=http://localhost:4000/api/github/callback
# Where the browser is sent after linking/unlinking GitHub (your app origin).
GITHUB_APP_ORIGIN=http://localhost:5173
# Note: the access token is encrypted with a key derived from SESSION_SECRET.
# Keep SESSION_SECRET stable in production or users must reconnect on restart.

# --- Deploy provider (optional) ---
# Reserved for real deployment providers (Vercel/Railway/Fly). When unset the
# built-in simulated provider is used and every deployment is labelled as demo.
DEPLOY_PROVIDER=

# --- AI assistant ---
# DevForge AI works out of the box with a built-in demo engine that answers
# from your real workspace data (no key required).
#
# To connect an external provider set AI_PROVIDER and the matching key.
# Supported providers: "openai-aicompat" (OpenAI, OpenRouter, groq, etc.)
AI_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini